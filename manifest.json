{
  "manifest_version": 3,
  "name": "OmniClick",
  "version": "2.3.0",
  "description": "Gmail tools for private notes, saved label/search tabs, and inline audio, with optional Google Drive note sync.",
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "action": {
    "default_title": "OmniClick",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "ik.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "shared.js",
        "core.js",
        "gsm.js",
        "content.js",
        "notes-store.js",
        "notes.js",
        "tabs-store.js",
        "tabs.js"
      ],
      "css": [
        "content.css",
        "notes.css",
        "tabs.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "options_page": "drive.html",
  "minimum_chrome_version": "120",
  "homepage_url": "https://wisecrunch.github.io/OmniClick/",
  "oauth2": {
    "client_id": "899675186596-gf9jrapdnek13sr1c2icfh47622i86g1.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
